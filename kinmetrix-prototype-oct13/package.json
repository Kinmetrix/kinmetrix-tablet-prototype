{
  "name": "kinmetrix-prototype-oct13",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:host": "vite --host 0.0.0.0",
    "lint": "oxlint src",
    "guardrails": "tsc --noEmit -p tsconfig.app.json && oxlint src && depcruise --config .dependency-cruiser.cjs src && node scripts/shaped-bans.mjs",
    "commitlint": "commitlint",
    "prepare": "node scripts/install-commit-hook.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.6.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
