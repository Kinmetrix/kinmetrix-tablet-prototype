#!/bin/sh
message_file=$1
repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root/kinmetrix-prototype-oct13" || exit 1

# Hooks do not load ~/.zshrc. Dock-launched git omits nvm and Homebrew.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v node >/dev/null 2>&1; then
  nvm_root="${NVM_DIR:-$HOME/.nvm}/versions/node"
  if [ -d "$nvm_root" ]; then
    node_bin=$(
      find "$nvm_root" -mindepth 2 -maxdepth 2 -type f -name node 2>/dev/null |
        while IFS= read -r bin; do
          ver=$(printf '%s\n' "$bin" | sed -n 's|.*/node/v\([^/]*\)/bin/node|\1|p')
          [ -n "$ver" ] || continue
          printf '%s %s\n' "$ver" "$(dirname "$bin")"
        done |
        sort -t. -k1,1n -k2,2n -k3,3n |
        awk 'END { print $2 }'
    )
    if [ -n "$node_bin" ]; then
      export PATH="$node_bin:$PATH"
    fi
  fi
fi

if ! command -v node >/dev/null 2>&1; then
  echo "commit-msg: node was not found. Install Node, or commit from a shell where it is on PATH." >&2
  exit 1
fi

cli="./node_modules/@commitlint/cli/cli.js"
if [ ! -f "$cli" ]; then
  echo "commit-msg: commitlint is not installed. Run yarn in kinmetrix-prototype-oct13." >&2
  exit 1
fi

exec node "$cli" --edit "$message_file"
