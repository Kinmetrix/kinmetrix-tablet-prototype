      "Catch": [
        { "ErrorEquals": ["Factory.ProposalInvalid"], "ResultPath": "$.run.feedback", "Next": "AnalyzeArchitecture" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }
