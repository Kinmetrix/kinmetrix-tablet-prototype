        "stage": "06-business-logic",
        "guide.$": "States.Format('{}/workers/reverse-analysis.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "repo.$": "$.run.repo",
        "context.$": "$.run.context",
        "template.$": "$.run.templates.analysisStage",
        "storeRoot.$": "$.run.storeRoot",
        "analysisPrefix.$": "States.Format('{}analysis/', $.run.staging)",
        "outputKey.$": "States.Format('{}analysis/06-business-logic.md', $.run.staging)",
        "validationFeedback.$": "$.run.feedback"
      },
      "ResultPath": "$.worker",
      "TimeoutSeconds": 86400,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ValidateBusinessLogic"
    },
    "ValidateBusinessLogic": {
      "Type": "Task",
      "Resource": "${ValidateStageFunctionArn}",
      "Parameters": { "stage": "06-business-logic", "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        { "ErrorEquals": ["Factory.ProposalInvalid"], "ResultPath": "$.run.feedback", "Next": "ExtractBusinessLogic" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }
      ],
      "Next": "MapUxFlows"
    },
    "MapUxFlows": {
      "Type": "Task",
      "Resource": "${ReverseAnalysisActivityArn}",
      "Parameters": {
        "role": "reverse-analysis",
        "stage": "07-ux-flows",
        "guide.$": "States.Format('{}/workers/reverse-analysis.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "repo.$": "$.run.repo",
        "context.$": "$.run.context",
        "template.$": "$.run.templates.analysisStage",
        "storeRoot.$": "$.run.storeRoot",
        "analysisPrefix.$": "States.Format('{}analysis/', $.run.staging)",
        "outputKey.$": "States.Format('{}analysis/07-ux-flows.md', $.run.staging)",
        "validationFeedback.$": "$.run.feedback"
      },
      "ResultPath": "$.worker",
      "TimeoutSeconds": 86400,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ValidateUxFlows"
    },
    "ValidateUxFlows": {
