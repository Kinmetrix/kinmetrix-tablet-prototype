{
  "Comment": "Spec-first software factory. forward: feature -> PRD. reverse: repo -> 7 analysis stages -> PRD. refine: committed PRD. Then human review loop -> flow lock -> prototype -> implementation -> verify, cut short by scope. Agents only propose; deterministic functions validate and commit.",
  "StartAt": "InitRun",
  "States": {
    "InitRun": {
      "Type": "Task",
      "Resource": "${InitRunFunctionArn}",
      "Parameters": {
        "input.$": "$",
        "executionName.$": "$$.Execution.Name"
      },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ChooseMode"
    },
    "ChooseMode": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.run.mode", "StringEquals": "forward", "Next": "AuthorPrd" },
        { "Variable": "$.run.mode", "StringEquals": "reverse", "Next": "DiscoverServices" },
        { "Variable": "$.run.mode", "StringEquals": "refine", "Next": "ReviewPrd" }
      ]
    },

    "AuthorPrd": {
      "Type": "Task",
      "Resource": "${PrdAuthorActivityArn}",
      "Parameters": {
        "role": "prd-author",
        "guide.$": "States.Format('{}/workers/prd-author.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "feature.$": "$.run.feature",
        "context.$": "$.run.context",
        "template.$": "$.run.templates.prd",
        "previousPrdKey.$": "$.run.prd.key",
        "storeRoot.$": "$.run.storeRoot",
        "outputKey.$": "States.Format('{}prd.md', $.run.staging)",
        "validationFeedback.$": "$.run.feedback"
      },
      "ResultPath": "$.worker",
      "TimeoutSeconds": 86400,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ValidateAuthoredPrd"
    },
    "ValidateAuthoredPrd": {
      "Type": "Task",
      "Resource": "${ValidatePrdFunctionArn}",
      "Parameters": { "role": "prd-author", "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        { "ErrorEquals": ["Factory.ProposalInvalid"], "ResultPath": "$.run.feedback", "Next": "AuthorPrd" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }
      ],
      "Next": "CommitAuthoredPrd"
    },
    "CommitAuthoredPrd": {
      "Type": "Task",
      "Resource": "${CommitPrdFunctionArn}",
      "Parameters": { "source": "author", "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ReviewPrd"
    },

    "DiscoverServices": {
      "Type": "Task",
      "Resource": "${ReverseAnalysisActivityArn}",
      "Parameters": {
        "role": "reverse-analysis",
        "stage": "01-service-discovery",
        "guide.$": "States.Format('{}/workers/reverse-analysis.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "repo.$": "$.run.repo",
        "context.$": "$.run.context",
        "template.$": "$.run.templates.analysisStage",
        "storeRoot.$": "$.run.storeRoot",
        "analysisPrefix.$": "States.Format('{}analysis/', $.run.staging)",
        "outputKey.$": "States.Format('{}analysis/01-service-discovery.md', $.run.staging)",
        "validationFeedback.$": "$.run.feedback"
      },
      "ResultPath": "$.worker",
      "TimeoutSeconds": 86400,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ValidateServiceDiscovery"
    },
    "ValidateServiceDiscovery": {
      "Type": "Task",
      "Resource": "${ValidateStageFunctionArn}",
      "Parameters": { "stage": "01-service-discovery", "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
