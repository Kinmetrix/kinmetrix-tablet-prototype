    "ValidatePrototype": {
      "Type": "Task",
      "Resource": "${ValidatePrototypeFunctionArn}",
      "Parameters": { "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        { "ErrorEquals": ["Factory.ProposalInvalid"], "ResultPath": "$.run.feedback", "Next": "BuildPrototype" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }
      ],
      "Next": "CommitPrototype"
    },
    "CommitPrototype": {
      "Type": "Task",
      "Resource": "${CommitPrototypeFunctionArn}",
      "Parameters": { "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ScopeAfterPrototype"
    },
    "ScopeAfterPrototype": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.run.scope", "StringEquals": "prototype", "Next": "FinalizeRun" }],
      "Default": "Implement"
    },

    "Implement": {
      "Type": "Task",
      "Resource": "${ImplementActivityArn}",
      "Parameters": {
        "role": "implement",
        "guide.$": "States.Format('{}/workers/implement.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "prdKey.$": "$.run.prd.key",
        "prdVersion.$": "$.run.prd.version",
        "prototypeKey.$": "$.run.prototype.key",
        "context.$": "$.run.context",
        "codeRoots.$": "$.run.codeRoots",
        "storeRoot.$": "$.run.storeRoot",
        "reportKey.$": "States.Format('{}implementation.json', $.run.staging)",
        "validationFeedback.$": "$.run.feedback"
      },
      "ResultPath": "$.worker",
      "TimeoutSeconds": 86400,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ValidateImplementation"
    },
    "ValidateImplementation": {
      "Type": "Task",
      "Resource": "${ValidateImplementationFunctionArn}",
      "Parameters": { "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        { "ErrorEquals": ["Factory.ProposalInvalid"], "ResultPath": "$.run.feedback", "Next": "Implement" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }
      ],
      "Next": "VerifyConfigured"
    },
    "VerifyConfigured": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.run.verify.configured", "BooleanEquals": true, "Next": "Verify" }],
      "Default": "FinalizeRun"
    },
    "Verify": {
      "Type": "Task",
      "Resource": "${VerifyFunctionArn}",
      "Parameters": { "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 3600,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        { "ErrorEquals": ["Factory.VerifyFailed"], "ResultPath": "$.run.feedback", "Next": "Implement" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }
      ],
      "Next": "FinalizeRun"
    },

    "FinalizeRun": {
      "Type": "Task",
      "Resource": "${FinalizeRunFunctionArn}",
      "Parameters": { "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed",
      "OutputPath": "$.run"
    },
    "RunFailed": {
      "Type": "Fail",
      "ErrorPath": "$.error.Error",
      "CausePath": "$.error.Cause"
    }
  }
}
