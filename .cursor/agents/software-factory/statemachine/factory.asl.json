      "Resource": "${PrdRefineActivityArn}",
      "Parameters": {
        "role": "prd-refine",
        "guide.$": "States.Format('{}/workers/prd-refine.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "prdKey.$": "$.run.prd.key",
        "prdVersion.$": "$.run.prd.version",
