      "Resource": "${PrdSynthesisActivityArn}",
      "Parameters": {
        "role": "prd-synthesis",
        "stage": "08-prd-synthesis",
        "guide.$": "States.Format('{}/workers/prd-synthesis.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "repo.$": "$.run.repo",
        "context.$": "$.run.context",
        "template.$": "$.run.templates.prd",
        "previousPrdKey.$": "$.run.prd.key",
        "storeRoot.$": "$.run.storeRoot",
        "analysisPrefix.$": "States.Format('{}analysis/', $.run.staging)",
        "outputKey.$": "States.Format('{}prd.md', $.run.staging)",
        "validationFeedback.$": "$.run.feedback"
      },
      "ResultPath": "$.worker",
      "TimeoutSeconds": 86400,
