        "role": "reverse-analysis",
        "stage": "02-graph-extraction",
        "guide.$": "States.Format('{}/workers/reverse-analysis.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "repo.$": "$.run.repo",
        "context.$": "$.run.context",
        "template.$": "$.run.templates.analysisStage",
        "storeRoot.$": "$.run.storeRoot",
        "analysisPrefix.$": "States.Format('{}analysis/', $.run.staging)",
        "outputKey.$": "States.Format('{}analysis/02-graph-extraction.md', $.run.staging)",
        "validationFeedback.$": "$.run.feedback"
      },
      "ResultPath": "$.worker",
      "TimeoutSeconds": 86400,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ValidateGraphExtraction"
    },
    "ValidateGraphExtraction": {
      "Type": "Task",
      "Resource": "${ValidateStageFunctionArn}",
      "Parameters": { "stage": "02-graph-extraction", "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        { "ErrorEquals": ["Factory.ProposalInvalid"], "ResultPath": "$.run.feedback", "Next": "ExtractGraph" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }
      ],
      "Next": "AnalyzeArchitecture"
    },
    "AnalyzeArchitecture": {
      "Type": "Task",
      "Resource": "${ReverseAnalysisActivityArn}",
      "Parameters": {
        "role": "reverse-analysis",
        "stage": "03-architecture",
        "guide.$": "States.Format('{}/workers/reverse-analysis.md', $.run.factoryDir)",
        "slug.$": "$.run.slug",
        "repo.$": "$.run.repo",
        "context.$": "$.run.context",
        "template.$": "$.run.templates.analysisStage",
        "storeRoot.$": "$.run.storeRoot",
        "analysisPrefix.$": "States.Format('{}analysis/', $.run.staging)",
        "outputKey.$": "States.Format('{}analysis/03-architecture.md', $.run.staging)",
        "validationFeedback.$": "$.run.feedback"
      },
      "ResultPath": "$.worker",
      "TimeoutSeconds": 86400,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "RunFailed" }],
      "Next": "ValidateArchitecture"
    },
    "ValidateArchitecture": {
      "Type": "Task",
      "Resource": "${ValidateStageFunctionArn}",
      "Parameters": { "stage": "03-architecture", "run.$": "$.run" },
      "ResultPath": "$.run",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
